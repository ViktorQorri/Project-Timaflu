@startuml
title SD05 - Potentiële klant zonder bestelling (acquisitie)
autonumber
actor "Acquisitiemedewerker" as M
participant "Potentiële klant" as P
participant "Acquisitiebezoek" as V
participant "Klant" as K
database "Prospects, bezoeken en bestellingen" as DB

M -> V: registreerBezoek(bedrijf, contact, adres, datum)
V -> DB: slaBezoekOp()
DB --> V: opgeslagen
V --> M: bezoek geregistreerd
M -> P: controleerOpvolgingNaEenMaand()
P -> DB: zoekZonderBestellingNaEenMaand()
DB --> P: kandidaten, contactgegevens
P -> P: controleerOfBestellingGeplaatst()
P --> M: opvolgstatus en contactgegevens
alt Geen bestelling en bezoek minstens een maand geleden
  M -> P: biedEenmaligeKortingAan(10%)
  P --> M: reactie op aanbod
  alt Prospect wil klant worden
    M -> P: maakKlantaccountAan()
    P -> K: registreerKlant()
    K -> DB: slaKlantOp()
    DB --> K: klantnummer
    K --> P: account en kortingsoptie
    P --> M: klantaccount geregistreerd
  else Prospect blijft prospect
    M -> M: planLatereOpvolging()
  end
else Wel besteld of bezoek recenter
  M -> M: geen opvolging nodig
end
@enduml
