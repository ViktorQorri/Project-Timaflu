@startuml
title SD05 - Prospective customer without an order (acquisition)
autonumber

actor "Acquisition employee" as M
participant "Prospective customer" as P
participant "Acquisition visit" as V
participant "Customer" as K
database "Prospects, visits and orders" as DB

M -> V: recordVisit(company, contact, address, date)
V -> DB: saveVisit()
DB --> V: saved
V --> M: visitRecorded
M -> P: checkFollowUpAfterOneMonth()
P -> DB: findProspectsWithoutOrdersAfterOneMonth()
DB --> P: prospects, contactDetails
P -> P: hasPlacedOrder()
P --> M: followUpStatus, contactDetails
alt No order and visit at least one month ago
  M -> P: offerOneTimeDiscount(10%)
  P --> M: offerResponse
  alt Prospect agrees to become a customer
    M -> P: createCustomerAccount()
    P -> K: registerCustomer()
    K -> DB: saveCustomer()
    DB --> K: customerNumber
    K --> P: accountDetails, discountOption
    P --> M: customerAccountRegistered
  else Prospect remains a prospect
    M -> M: scheduleLaterFollowUp()
  end
else Order already placed or visit more recent
  M -> M: noFollowUpRequired()
end
@enduml
