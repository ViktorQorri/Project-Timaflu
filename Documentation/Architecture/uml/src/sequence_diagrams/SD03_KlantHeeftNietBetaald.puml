@startuml
title SD03 - Klant heeft niet betaald (administratie)
autonumber
actor "Administratiemedewerker" as A
participant "Customer" as K
participant "Invoice" as F
participant "PaymentReminder" as H
database "Factuurgegevens" as DB
A -> K: zoekKlant(klantnummer)
K -> DB: zoekOpenstaandeFacturen(klantnummer)
DB --> K: facturen en betaaldatum
K --> A: openstaande facturen
alt Achterstallige factuur
 A -> F: checkPaymentArrears()
 F -> DB: laadFactuurEnRegels()
 DB --> F: regels, korting, 9% btw, totaal
 alt Eerste of tweede herinnering
   F -> H: send()
   H --> F: herinnering verzonden
 else Na herinneringen onbetaald
   F -> F: proposePaymentPlan()
   alt Betalingsregeling akkoord
     F --> A: regeling vastgelegd
   else Niet akkoord
     F -> F: enableDebtCollection()
     F -> K: checkOrderBlock()
     F --> A: incasso en orderblokkade
   end
 end
else Reeds betaald
 K --> A: geen achterstand
end
@enduml
