@startuml
title SD03 - Klant heeft niet betaald (administratie)
autonumber
actor "Administratiemedewerker" as A
participant "Klant" as K
participant "Factuur" as F
participant "Betalingsherinnering" as H
database "Factuurgegevens" as DB

A -> K: zoekKlant(klantnummer)
K -> DB: zoekOpenstaandeFacturen(klantnummer)
DB --> K: facturen en vervaldata
K --> A: openstaande facturen
alt Achterstallige factuur
  A -> F: controleerBetalingsachterstand()
  F -> DB: laadFactuurEnRegels()
  DB --> F: regels, korting, btw, totaal
  F --> A: betalingsstatus en factuurdetails
  alt Eerste of tweede herinnering
    A -> H: verstuurHerinnering(factuur)
    H --> A: herinnering verzonden
  else Na herinneringen nog onbetaald
    A -> F: stelBetalingsregelingVoor()
    F --> A: voorstel betalingsregeling
    alt Betalingsregeling akkoord
      A -> F: legBetalingsregelingVast()
      F --> A: regeling vastgelegd
    else Betalingsregeling niet akkoord
      A -> F: startIncassoprocedure()
      F --> A: incasso gestart
      A -> K: controleerEnBlokkeerBestellingen()
      K --> A: bestelblokkade bevestigd
    end
  end
else Factuur reeds betaald
  A -> A: geen vervolgactie nodig
end
@enduml
