@startuml
title SD03 - Customer has not paid (administration)
autonumber

actor "Administration employee" as A
participant "Customer" as K
participant "Invoice" as F
participant "Payment reminder" as H
database "Invoice records" as DB

A -> K: findCustomer(customerNumber)
K -> DB: findOutstandingInvoices(customerNumber)
DB --> K: invoices, dueDates
K --> A: outstandingInvoices
alt Overdue invoice
  A -> F: checkPaymentArrears()
  F -> DB: loadInvoiceAndLineItems()
  DB --> F: lineItems, discount, VAT, total
  F --> A: paymentStatus, invoiceDetails
  alt First or second reminder
    A -> H: sendReminder(invoice)
    H --> A: reminderSent
  else Still unpaid after reminders
    A -> F: proposePaymentPlan()
    F --> A: paymentPlanProposal
    alt Payment plan accepted
      A -> F: recordPaymentPlan()
      F --> A: paymentPlanRecorded
    else Payment plan rejected
      A -> F: initiateDebtCollection()
      F --> A: debtCollectionInitiated
      A -> K: checkAndBlockOrders()
      K --> A: orderBlockConfirmed
    end
  end
else Invoice already paid
  A -> A: noFurtherActionRequired()
end
@enduml
