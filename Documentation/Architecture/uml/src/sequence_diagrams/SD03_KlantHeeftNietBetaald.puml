@startuml
title SD03 - Handle unpaid invoice (UC18 / AD18)
autonumber
actor "Administration employee" as Admin
participant "invoice:Invoice" as Invoice
participant "reminder:PaymentReminder" as Reminder
actor "Customer contact" as Contact
participant "customer:Customer" as Customer
Admin -> Invoice: checkPaymentArrears()
activate Invoice
Invoice --> Admin: paidOn, weeksOverdue, reminder history
deactivate Invoice
alt Invoice is paid or not yet one week overdue
  note right of Admin: No action required.
else Unpaid for one or two weeks
  Admin -> Reminder: send()
  activate Reminder
  Reminder --> Admin: reminder sent (first or second)
  deactivate Reminder
else Unpaid for at least three weeks
  Admin -> Invoice: proposePaymentPlan()
  Invoice --> Admin: standard payment plan proposal
  Admin -> Contact: Call customer and offer payment plan
  Contact --> Admin: accepted / declined
  alt Customer accepts
    Admin -> Invoice: Set paymentPlanAccepted = true
    Invoice --> Admin: payment plan recorded
  else Customer declines
    Admin -> Invoice: enableDebtCollection()
    Invoice --> Admin: debtCollectionEnabled
    Admin -> Customer: checkOrderBlock()
    Customer --> Admin: new orders blocked until all outstanding invoices are paid
  end
end
@enduml
