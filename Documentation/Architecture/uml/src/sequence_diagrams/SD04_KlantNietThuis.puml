@startuml
title SD04 - Customer not home during delivery (distribution)
autonumber

actor "Courier" as K
participant "Route" as R
actor "Customer contact" as C
actor "Sales employee" as S
participant "Delivery attempt" as D
participant "Order" as O

K -> R: showSchedule(date)
R --> K: schedule, addresses, contactDetails
K -> C: callCustomerWhenNoAnswer()
C --> K: customerAvailability
alt Customer available later the same day
  K -> R: adjustSchedule()
  R --> K: updatedSchedule
  K -> C: requestSignature()
  C --> K: signedReceipt
  K -> D: recordReceiptSignature()
  D --> K: signatureSaved
  K -> D: markDelivered(timestamp)
  D -> O: changeOrderStatus(delivered)
  O --> D: statusUpdated
  D --> K: deliveryRecorded
else Customer unavailable on both attempts
  K -> D: markRecipientAbsent()
  D -> O: changeOrderStatus(notDelivered)
  O --> D: statusUpdated
  D --> K: failedDeliveryRecorded
  K -> S: reportFailedDelivery()
  S -> C: agreeNewDeliveryDateAndTimeSlot()
  C --> S: date, timeSlot
  S -> O: setDeliveryTime(date, timeSlot)
  O --> S: revisedDeliveryTimeSaved
  S -> O: recordAdditionalDeliveryCosts(amount, explanation)
  O --> S: additionalCostsRecorded
end
@enduml
