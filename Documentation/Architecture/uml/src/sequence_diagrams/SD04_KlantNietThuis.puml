@startuml
title SD04 - Mislukte levering afhandelen (UC12 / AD27)
autonumber
actor "Koerier" as Courier
participant "route:Route" as Route
actor "Contactpersoon klant" as Contact
participant "first:DeliveryAttempt" as First
participant "second:DeliveryAttempt" as Second
participant "order:Order" as Order
actor "Verkoopmedewerker" as Sales
Courier -> Route: showSchedule(date)
Route --> Courier: rit, adres en geplande tijd
Courier -> Courier: lookUpCustomerPhoneNumber(customer)
Courier -> Contact: Bel na eerste vergeefse bezoek
Contact --> Courier: bereikbaarheid
alt Klant aanwezig bij eerste bezoek
  Courier -> First: recordReceiptSignature()
  First --> Courier: ontvangstondertekening geregistreerd
  Courier -> First: markDelivered(timestamp)
  First --> Courier: aflevering geregistreerd
  Courier -> Order: changeOrderStatus(delivered)
  Order --> Courier: orderstatus bijgewerkt
else Klant niet aanwezig bij eerste bezoek
  Courier -> First: markRecipientAbsent()
  First --> Courier: eerste poging geregistreerd
  Courier -> Route: adjustSchedule()
  Route --> Courier: tweede bezoek op dezelfde dag ingepland
  alt Klant aanwezig bij tweede poging
    Courier -> Second: recordReceiptSignature()
    Second --> Courier: ontvangstondertekening geregistreerd
    Courier -> Second: markDelivered(timestamp)
    Second --> Courier: aflevering geregistreerd
    Courier -> Order: changeOrderStatus(delivered)
    Order --> Courier: orderstatus bijgewerkt
  else Klant ook bij tweede poging niet aanwezig
    Courier -> Second: markRecipientAbsent()
    Second --> Courier: tweede poging geregistreerd
    Courier -> Order: changeOrderStatus(notDelivered)
    Order --> Courier: orderstatus bijgewerkt
    note right of Courier: Breng medicijnen terug naar de distributiehoek.
    Courier -> Sales: Meld mislukte levering
    Sales -> Contact: Spreek nieuwe datum en dagdeel af
    Contact --> Sales: nieuwe datum en dagdeel
    Sales -> Order: setDeliveryTime(date, timeSlot)
    Order --> Sales: afspraak bijgewerkt
    Sales -> Order: recordAdditionalDeliveryCosts(amount, explanation)
    Order --> Sales: extra bezorgkosten vastgelegd
  end
end
@enduml
