@startuml
title SD01 - Berekenen klantenkorting (verkoop)
autonumber
actor "Verkoopmedewerker" as V
participant "Bestelling" as O
participant "Klant" as K
participant "Klantenkorting" as D
database "Bestellingen" as DB

V -> O: berekenTotaalbedrag(klant, bestelregels)
activate O
O -> DB: telEerdereBestellingen(klant)
DB --> O: aantalBestellingen
alt Eerste bestelling
  O -> O: berekenEenmaligeKorting(10%)
else Bestaande klant
  O -> K: berekenJaaromzet(vorigJaar)
  K -> DB: somAankopen(vorigJaar)
  DB --> K: jaaromzet
  K --> O: jaaromzet
  O -> D: bepaalKortingspercentage(jaaromzet)
  D --> O: kortingspercentage
  O -> O: berekenKlantenkorting()
end
O -> O: berekenTotaalbedragNaKorting()
O --> V: totaalbedrag, toegepasteKortingen
deactivate O
@enduml
