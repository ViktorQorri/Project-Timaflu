@startuml
title SD01 - Calculate customer discount (sales)
autonumber

actor "Sales employee" as V
participant "Order" as O
participant "Customer" as K
participant "Customer discount" as D
database "Orders" as DB

V -> O: calculateTotalAmount(customer, orderLines)
activate O
O -> DB: countPreviousOrders(customer)
DB --> O: numberOfOrders
alt First order
  O -> O: calculateOneTimeDiscount(10%)
else Existing customer
  O -> K: calculateAnnualRevenue(previousYear)
  K -> DB: sumPurchases(previousYear)
  DB --> K: annualRevenue
  K --> O: annualRevenue
  O -> D: determineDiscountPercentage(annualRevenue)
  D --> O: discountPercentage
  O -> O: calculateCustomerDiscount()
end
O -> O: calculateTotalAfterDiscount()
O --> V: totalAmount, appliedDiscounts
deactivate O
@enduml
