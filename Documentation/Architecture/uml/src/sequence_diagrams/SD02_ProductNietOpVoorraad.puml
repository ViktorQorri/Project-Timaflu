@startuml
title SD02 - Reorder product below minimum stock (UC02 / AD02)
autonumber
actor "Purchasing employee" as Purchasing
participant "product:Product" as Product
participant "location:WarehouseLocation" as Location
participant "offer:SupplierOffer" as Offer
actor "Manufacturer" as Manufacturer
participant "purchaseOrder:PurchaseOrder" as PurchaseOrder
Purchasing -> Product: checkMinimumStock()
activate Product
Product -> Location: Read quantity
Location --> Product: currentPhysicalStock
Product --> Purchasing: currentPhysicalStock, minimumStock
deactivate Product
alt Below minimum stock
  note right of Purchasing: Select the product and desired reorder quantity.
  Purchasing -> Product: findSuppliersByPrice()
  activate Product
  Product -> Offer: Read purchasePrice and linked Supplier
  Offer --> Product: ranked supplier offers
  Product --> Purchasing: offers sorted cheapest first
  deactivate Product
  loop For each supplier until an order is confirmed or options are exhausted
    Purchasing -> Manufacturer: Ask availability for requested quantity
    Manufacturer --> Purchasing: available / unavailable / discontinued
    opt Permanently discontinued by this manufacturer
      Purchasing -> Product: removeSupplier(supplier)
      Product --> Purchasing: supplier link removed
    end
    alt Manufacturer can supply requested quantity
      Purchasing -> Manufacturer: Confirm purchase directly
      Manufacturer --> Purchasing: confirmed purchase
      Purchasing -> PurchaseOrder: placeWithSupplier()
      PurchaseOrder --> Purchasing: purchase order recorded
    else Manufacturer unavailable
      note right of Purchasing: Try the next cheapest supplier, if any.
    end
  end
  opt No manufacturer can deliver
    note right of Purchasing: Remove from internal reorder list only, not the product assortment.
  end
else Sufficient stock
  note right of Purchasing: No reorder needed.
end
@enduml
