@startuml
title SD02 - Product out of stock (purchasing)
autonumber

actor "Purchasing employee" as I
participant "Product" as P
database "Warehouse location" as M
database "Supplier offers" as A
participant "Supplier" as L
participant "Purchase order" as PO

I -> P: checkMinimumStock()
P -> M: getPhysicalStock(product)
M --> P: quantity
P --> I: currentStock, minimumStock
alt Below minimum stock level
  I -> P: findSuppliersByPrice()
  P -> A: listOffersSortedByPrice(product)
  A --> P: offers, contactName, phoneNumber
  P --> I: suppliers sorted by price
  loop While no supplier can deliver and options remain
    I -> L: checkAvailability()
    L --> I: availability
  end
  alt Supplier can deliver
    I -> L: confirmOrder()
    L --> I: orderConfirmed
    I -> PO: placeWithSupplier()
    PO --> I: purchaseOrderRegistered
  else No supplier can deliver
    I -> I: removeProductFromInternalReorderList()
    note right of I: Do not remove the product from the entire assortment
  end
else Sufficient stock
  I -> I: noReorderRequired()
end
@enduml
