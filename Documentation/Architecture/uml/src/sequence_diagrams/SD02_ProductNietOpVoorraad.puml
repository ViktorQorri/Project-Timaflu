@startuml
title SD02 - Reorder product below minimum stock (UC02 / AD02)
autonumber
actor "Purchasing employee" as Purchasing
participant "product:Product" as Product
participant "location:WarehouseLocation" as Location
participant "offer:SupplierOffer" as Offer
actor "Manufacturer" as Manufacturer
participant "purchaseOrder:PurchaseOrder" as PurchaseOrder
Purchasing -> Product: checkMinimumStock()
activate Product
Product -> Location: Read quantity
Location --> Product: currentPhysicalStock
Product --> Purchasing: currentPhysicalStock, minimumStock
deactivate Product
alt Below minimum stock
  note right of Purchasing: Select product and desired quantity.
  Purchasing -> Product: findSuppliersByPrice()
  activate Product
  Product -> Offer: Read purchasePrice and linked Supplier
  Offer --> Product: ranked supplier offers
  Product --> Purchasing: offers ordered by price
  deactivate Product
  loop For each remaining manufacturer, cheapest first
    Purchasing -> Manufacturer: Request availability for selected quantity
    Manufacturer --> Purchasing: available / unavailable / discontinued
    alt Manufacturer is able to deliver
      Purchasing -> Manufacturer: Confirm purchase
      Manufacturer --> Purchasing: purchase confirmed
      Purchasing -> PurchaseOrder: placeWithSupplier()
      PurchaseOrder --> Purchasing: confirmed order recorded
      break Order confirmed; stop contacting manufacturers
      end
    else Manufacturer cannot deliver
      opt Manufacturer permanently discontinued this product
        Purchasing -> Product: removeSupplier(supplier)
        Product --> Purchasing: manufacturer link removed
      end
      note right of Purchasing: Continue with the next cheapest offer.
    end
  end
  opt All manufacturers exhausted without a confirmed purchase
    note right of Purchasing
      Remove the product from the internal reorder list.
      Do not remove it from the overall assortment.
    end note
  end
else Stock is sufficient
  note right of Purchasing: No purchase order required.
end
@enduml
