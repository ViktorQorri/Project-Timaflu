@startuml
skinparam conditionStyle diamond
skinparam ConditionEndStyle diamond
skinparam ActivityDiamondFontSize 11

|Courier|
start
:Select an assigned delivery;
if (Customer present on first visit?) then ([yes])
  |Customer|
  :Sign for receipt;
  |Courier|
  :Confirm signed receipt;
  |System|
  :Record confirmation of signed receipt\nand delivery time;
  :Update order status if all required\nproducts were delivered;
  stop
else ([no])
  |Courier|
  :Look up customer phone number\nand contact the customer;
  :Execute AD27 Handle failed delivery:\nplan second attempt later today;
  |System|
  :Record actual outcomes and follow-up\nwithout inventing a signature;
  stop
endif
@enduml
