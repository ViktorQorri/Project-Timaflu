@startuml
skinparam conditionStyle diamond
skinparam ConditionEndStyle diamond
skinparam ActivityDiamondFontSize 11

|Distribution Employee|
start
:Open packed orders ready for delivery;
|System|
:Show destination, requested\ndate and time slot, and rush flag;
|Distribution Employee|
while (Another order to assign?) is ([yes])
  :Select packed order;
  if (Rush order?) then ([yes])
    |System|
    :Show available in-house couriers\n(regardless of region);
    if (In-house courier available?) then ([yes])
      |Distribution Employee|
      :Choose available courier for priority delivery;
      |System|
      :Validate separate priority rush trip;
    else ([no])
      |Sales Employee|
      :Contact external rush courier;
      |System|
      |Distribution Employee|
      :Register the externally arranged courier;
      |System|
      :Validate the external rush assignment;
    endif
  else ([no])
    |System|
    :Show couriers for the destination region\nand agreed delivery time slot;
    if (Pickup before 17:00\nand courier available?) then ([yes])
      |Distribution Employee|
      :Choose available regional courier;
      |System|
      :Validate the requested route and slot;
    else ([no])
      :Leave order awaiting a suitable\npickup and agreed delivery window;
    endif
  endif
  |System|
  :Save the confirmed trip assignment\nor keep the order awaiting assignment;
  :Update delivery details for courier;
  |Distribution Employee|
endwhile ([no])
stop
@enduml
