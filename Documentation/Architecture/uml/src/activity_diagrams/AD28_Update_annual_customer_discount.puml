@startuml
skinparam conditionStyle diamond
skinparam ConditionEndStyle diamond
skinparam ActivityDiamondFontSize 11

|System|
start
:On December 31, start annual\ndiscount determination;
while (Another customer to process?) is ([yes])
  :Calculate customer's annual revenue\nfrom fully paid invoices;
  if (Annual revenue < EUR 10,000?) then ([yes])
    :Set discount to 5%;
  else ([no])
    if (Annual revenue < EUR 20,000?) then ([yes])
      :Set discount to 10%;
    else ([no])
      :Set discount to 15%;
    endif
  endif
  :Save customer discount\nfor next calendar year;
endwhile ([no])
:Show annual discount update complete;
stop
@enduml
