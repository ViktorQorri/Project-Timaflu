@startuml
skinparam conditionStyle diamond
skinparam ConditionEndStyle diamond
skinparam ActivityDiamondFontSize 11

|Sales Employee|
start
:Look up customer;

|System|
:Show customer data;
if (Customer blocked\n(debt collection)?) then ([yes])
  :Show message that customer\ncannot place orders;
  stop
else ([no])
endif

|Sales Employee|
:Ask customer which product\nthey want to order;
while (Add another product?) is ([yes])
  :Enter product and quantity;
  |System|
  :Execute AD UC04 Check stock;
  if (Sufficient stock?) then ([yes])
    :Add order line\nand reserve stock;
  else ([no])
    :Report shortage\n(possible backorder);
  endif
  |Sales Employee|
  :Ask customer for another product;
endwhile ([no])

if (Rush order?) then ([yes])
  :Mark as rush order;
else ([no])
endif

|System|
:Calculate price and discount;
:Show total price;
|Sales Employee|
:Ask customer for approval;
while (Customer wants to\nchange order?) is ([yes])
  :Adjust order lines;
  |System|
  :Calculate price and discount;
  :Show total price;
  |Sales Employee|
  :Ask customer for approval;
endwhile ([no])

if (Customer agrees?) then ([yes])
  :Schedule delivery time;
  |System|
  :Save order;
  :Pick order;
  :Show order number;
  stop
else ([no])
  |Sales Employee|
  :Cancel order and end call;
  stop
endif
@enduml