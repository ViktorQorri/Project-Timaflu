@startuml
left to right direction
skinparam packageStyle rectangle

actor "Verkoopmedewerker" as Sales
actor "Magazijnrobot" as Robot
actor "Distributiemedewerker" as Distro
actor "Inkoopmedewerker" as Purchaser
actor "Administratiemedewerker" as Admin
actor "Koerier" as Courier
actor "Acquisitiemedewerker" as Acquisition
actor "Directie" as Management

rectangle "Timaflu Systeem" {
    
    Sales --> (Bestelling registreren)
    Sales --> (Gegevens beheren)
    Sales --> (Orderstatus opvragen)
    
    (Bestelling registreren) ..> (Voorraad controleren) : <<include>>
    
    Robot --> (Verzamelbak scannen)
    Robot --> (Deelorder verzamelen)
    Robot --> (Ordercompleetheid melden)
    Robot --> (Volgende deelorder opvragen)
    
    (Deelorder verzamelen) ..> (Voorraad controleren) : <<include>>
    
    Distro --> (Order verpakken)
    Distro --> (Bezorgritten toewijzen)
    
    Purchaser --> (Voorraad bewaken)
    Purchaser --> (Producten bijbestellen)
    Purchaser --> (Nieuw medicijn beoordelen)
    Management --> (Nieuw medicijn beoordelen)
    
    Admin --> (Facturatie beheren)
    Admin --> (Inkoopfacturen betalen)
    Admin --> (Jaarlijkse klantenkorting vaststellen)
    
    Courier --> (Ritgegevens raadplegen)
    Courier --> (Telefoonnummer klant opzoeken)
    Courier --> (Levering registreren)
    Courier --> (Tweede afleverpoging registreren)

    Acquisition --> (Acquisitiebezoek registreren)
    Acquisition --> (Acquisitieoverzicht bekijken)
    Acquisition --> (Potentiele klant opvolgen)
}
@enduml