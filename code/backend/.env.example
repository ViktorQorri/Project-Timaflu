# Copy this file to .env and fill in the values. Never commit .env.
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
# Managed/remote MySQL: set DB_REQUIRE_TLS=1 and the CA certificate path.
# TLS certificate + server hostname are verified; never turn this off on public networks.
DB_REQUIRE_TLS=
DB_SSL_CA=
# Real Timaflu sender address, required before issuing printable invoices.
# The school case does not provide one; do not substitute a fictitious address.
TIMAFLU_ADDRESS=
# Wettelijk geverifieerd btw-percentage voor extra herbezorgkosten (bijv. volgens eigen adviseur).
# Geen standaard: ontbrekende waarde blokkeert uitsluitend facturatie met die kosten.
# Het formulierbedrag is het afgesproken bedrag inclusief eventuele btw.
TIMAFLU_DELIVERY_COST_VAT_PERCENT=

# Signs the session cookie (flash messages, later the login). Keep it secret.
# Locally you can leave it empty: a random key is made at every start, so sessions reset on restart.
# When hosting, set a fixed random value: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
