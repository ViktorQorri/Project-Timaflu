@startuml title Manage customers
top to bottom direction



actor "Sales Employee" as SalesEmployee

rectangle "Manage customers" {

    usecase "Create customer" as CreateCustomer
    usecase "Edit customer" as EditCustomer
    usecase "Delete customer" as DeleteCustomer

    usecase "Register delivery address" as DeliveryAddress
    usecase "Register invoice address" as InvoiceAddress
    usecase "Register phone number" as PhoneNumber
    usecase "Register annual revenue" as AnnualRevenue
}

SalesEmployee --> CreateCustomer
SalesEmployee --> EditCustomer
SalesEmployee --> DeleteCustomer

CreateCustomer ..> DeliveryAddress : <<include>>
CreateCustomer ..> InvoiceAddress : <<include>>
CreateCustomer ..> PhoneNumber : <<include>>
CreateCustomer ..> AnnualRevenue : <<include>>

EditCustomer ..> DeliveryAddress : <<include>>
EditCustomer ..> InvoiceAddress : <<include>>
EditCustomer ..> PhoneNumber : <<include>>
EditCustomer ..> AnnualRevenue : <<include>>

@enduml